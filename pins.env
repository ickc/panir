# What the schema and corpus are generated from. CI exports these.
PANDOC_TYPES_VERSION=1.23.1.2
# The pandoc whose markdown reader and Lua filters make corpus/pandoc.jsonl
# and corpus/filters.jsonl (scripts/pandoc-corpus.sh, filters-corpus.sh).
PANDOC_VERSION=3.14
# Hackage snapshot for dependency resolution (QuickCheck's generator decides
# the corpus, so it is pinned too). Same as libpandoc's for pandoc 3.14.
INDEX_STATE=2026-11-12T04:32:26Z
GHC_VERSION=9.10.3
# cabal: 3.14 still, though upstream's 3.14 release used 3.18.2.0: ghcup's
# aarch64 cabal 3.18 needs glibc 2.34 (manylinux_2_28 has 2.28). cabal only
# resolves the plan, which INDEX_STATE fixes; pandoc-forge keeps 3.14 too.
CABAL_VERSION=3.14.2.0
